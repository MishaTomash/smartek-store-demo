# Змінні середовища для підключення бази даних та налаштування сервера
MONGO_URI=your_mongodb_connection_string_here
PORT=5000
CLIENT_URL=http://localhost:5173

# Облікові дані для доступу до AdminJS панелі
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_admin_password
# Мінімум 32 символи. Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_session_secret_string_at_least_32_chars

# production вмикає secure-cookie для сесії адмінки (потрібен HTTPS)
NODE_ENV=development